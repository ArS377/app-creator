    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
