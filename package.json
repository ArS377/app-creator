{
  "name": "living-blueprint",
  "version": "1.0.0",
  "private": true,
  "description": "A live, explorable blueprint for AI-generated Replit apps.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "vite --host 0.0.0.0",
